{
  "manifest_version": 3,
  "name": "UNiBOX",
  "version": "0.2.0",
  "description": "Adds a filter bar above Gmail to sort university emails into categories. Display only — never modifies, archives, or deletes anything.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.groq.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UNiBOX"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["selectors.js", "senderMap.js", "rules.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
