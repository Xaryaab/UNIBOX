{
  "manifest_version": 3,
  "name": "UNiBOX",
  "version": "0.1.0",
  "description": "Adds a filter bar above Gmail to sort university emails into categories. Display only — never modifies, archives, or deletes anything.",
  "permissions": ["storage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["selectors.js", "rules.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
